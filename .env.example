# Company Researcher Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Authentication (required for production)
# =============================================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here

# =============================================================================
# AI Provider API Keys (at least one required)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# =============================================================================
# Search API Keys (ALL OPTIONAL - Free providers used by default)
# =============================================================================
# The system uses parallel multi-engine search for faster, more comprehensive results.
# Free providers (DuckDuckGo, Jina) work without API keys.
#
# Priority order: DuckDuckGo(1) → Jina(2) → LangSearch(3) → Brave(3) → Serper(4) → Bing(4) → Tavily(5)

# Tavily - AI-optimized search (1,000 free/month, then $8/1K)
# Get key at: https://tavily.com/
# TAVILY_API_KEY=tvly-your-tavily-key-here

# Serper.dev - Google search results via API (2,500 free, then $1/1K)
# Get key at: https://serper.dev/
# SERPER_API_KEY=your-serper-key-here

# Brave Search API - Privacy-focused, independent index (2,000 free/month, then $5/1K)
# Get key at: https://brave.com/search/api/
# BRAVE_API_KEY=your-brave-api-key-here

# Bing Search API - Microsoft's search via Azure (1,000 free/month)
# Get key at: https://azure.microsoft.com/en-us/services/cognitive-services/bing-web-search-api/
# BING_API_KEY=your-bing-api-key-here

# Jina AI - Optional for higher limits (10M tokens free without key)
# Get key at: https://jina.ai/
# JINA_API_KEY=your-jina-key-here

# LangSearch - AI-optimized search (FREE for individuals)
# Get key at: https://langsearch.com/
# LANGSEARCH_API_KEY=your-langsearch-key-here

# =============================================================================
# MCP Docker Server API Keys (for enhanced research capabilities)
# =============================================================================
# Firecrawl - Powerful web scraping (https://firecrawl.dev/)
# FIRECRAWL_API_KEY=your-firecrawl-key-here

# Exa - AI-powered web search (https://exa.ai/)
# EXA_API_KEY=your-exa-key-here

# Perplexity - Real-time research (https://perplexity.ai/)
# PERPLEXITY_API_KEY=your-perplexity-key-here

# News API (optional - for news intelligence feature)
# Get free key at: https://newsapi.org/ (100 requests/day free)
NEWSAPI_KEY=your-newsapi-key-here
# SERPAPI_API_KEY=your-serpapi-key-here

# =============================================================================
# News Intelligence (NewsAPI)
# =============================================================================
# Enable/disable news intelligence feature (default: true)
# When enabled, fetches recent news, analyzes sentiment, and detects business signals
# ENABLE_NEWS_INTELLIGENCE=true

# How far back to search for company news (days, max 30 for free tier)
# NEWS_COMPANY_LOOKBACK_DAYS=30

# How far back to search for industry news (days)
# NEWS_INDUSTRY_LOOKBACK_DAYS=14

# =============================================================================
# SEC EDGAR Integration (for US-listed companies)
# =============================================================================
# Identity for SEC EDGAR API (required - SEC requires contact info in User-Agent)
SEC_IDENTITY=Your Name (your.email@example.com)

# Enable/disable SEC filings integration (default: true)
# When enabled, automatically fetches 10-K, 10-Q, 8-K filings for US-listed companies
# ENABLE_SEC_FILINGS=true

# =============================================================================
# Financial Deep Dive (Financial Modeling Prep)
# =============================================================================
# Enable/disable financial deep dive feature (default: true)
# When enabled, fetches detailed financials, analyst estimates, and company ratings
# Requires company to have a known ticker symbol
# ENABLE_FINANCIAL_DEEP_DIVE=true

# =============================================================================
# Unified Data Source Orchestration (ARCH-001)
# =============================================================================
# Enable/disable unified data source orchestration (default: true)
# When enabled, pre-fetches data from all available sources in parallel:
# - SEC filings (for US-listed companies)
# - Alpha Vantage (stock data)
# - Financial Modeling Prep (detailed financials)
# - NewsAPI (news articles)
# - GitHub (for tech companies)
# - OpenCorporates (company registry)
# - Reddit/Twitter (social sentiment)
# ENABLE_UNIFIED_FETCH=true

# =============================================================================
# Langfuse Observability (optional - for AI cost & performance tracking)
# =============================================================================
# Langfuse provides tracing, cost tracking, and quality monitoring for AI operations.
# Get free keys at: https://langfuse.com/
#
# Features when enabled:
# - Per-company, per-section AI cost tracking
# - Latency monitoring for identifying slow operations
# - Full trace of every AI call for debugging
# - Quality metrics over time
#
# LANGFUSE_PUBLIC_KEY=pk-your-public-key
# LANGFUSE_SECRET_KEY=sk-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true  # Set to false to disable observability

# =============================================================================
# AI Configuration (optional - defaults shown)
# =============================================================================
# DEFAULT_MODEL=gpt-4o
# DEFAULT_TEMPERATURE=0.0
# DEFAULT_MAX_TOKENS=4000

# =============================================================================
# Application Configuration (optional)
# =============================================================================
# OUTPUT_DIR=outputs
# DB_PATH=tasks.db
# LOG_DIR=.
# PROMPTS_DIR=src/prompts
# TEMPLATES_DIR=src/templates

# =============================================================================
# API Server Configuration (optional)
# =============================================================================
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# MAX_REQUEST_SIZE_BYTES=1000000
# RESEARCH_TIMEOUT_SECONDS=1800

# =============================================================================
# Performance Tuning (optional)
# =============================================================================
# SEARCH_TIMEOUT_SECONDS=30
# VAULT_FILE_TIMEOUT_SECONDS=30
# ROUTER_COUNTER_RESET_SECONDS=3600

# =============================================================================
# Security Configuration (SEC-010)
# =============================================================================
# Enable/disable prompt injection blocking
# SECURITY_BLOCK_INJECTION=true
# Minimum threat level to block (none, low, medium, high, critical)
# SECURITY_MIN_BLOCK_LEVEL=medium

# =============================================================================
# Vault Encryption (SEC-006)
# =============================================================================
# Encryption key for vault data (base64-encoded, generate with Fernet.generate_key())
# VAULT_ENCRYPTION_KEY=your-base64-encryption-key
# Or use a master password (key will be derived)
# VAULT_MASTER_PASSWORD=your-secure-master-password

# =============================================================================
# Telemetry & Observability (OPS-001)
# =============================================================================
# OpenTelemetry
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=company-researcher
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_CONSOLE_EXPORTER=false
# OTEL_TRACE_SAMPLE_RATE=1.0

# Prometheus Metrics
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Graceful Shutdown (OPS-002)
# =============================================================================
# Maximum time to wait for in-flight requests during shutdown (seconds)
# SHUTDOWN_TIMEOUT_SECONDS=30

# =============================================================================
# Financial Data APIs (optional - for enhanced financial research)
# =============================================================================
# Alpha Vantage (stock data, forex, crypto)
# Get free key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your-key-here

# Financial Modeling Prep (company financials, SEC filings)
# Get free key at: https://financialmodelingprep.com/developer/docs/
# FINANCIAL_MODELING_PREP_API_KEY=your-key-here

# Open Exchange Rates (currency conversion)
# Get free key at: https://openexchangerates.org/signup
# OPEN_EXCHANGE_RATES_APP_ID=your-app-id-here

# =============================================================================
# Business Data APIs (optional)
# =============================================================================
# OpenCorporates (company registry data worldwide)
# Get key at: https://api.opencorporates.com/
# OPENCORPORATES_API_KEY=your-key-here

# WHOIS API (domain ownership data)
# Get key at: https://www.whoisxmlapi.com/
# WHOIS_API_KEY=your-key-here

# =============================================================================
# Social Media APIs (optional - for social sentiment research)
# =============================================================================
# Enable/disable social intelligence feature (default: true)
# When enabled, fetches Reddit/Twitter mentions, sentiment analysis, and social risks
# ENABLE_SOCIAL_INTELLIGENCE=true

# Reddit API (social sentiment, discussions)
# Get credentials at: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your-client-id
# REDDIT_CLIENT_SECRET=your-client-secret
# REDDIT_USER_AGENT=CompanyResearcher/1.0

# Twitter/X API (social media presence - limited free tier)
# Get key at: https://developer.twitter.com/
# TWITTER_BEARER_TOKEN=your-bearer-token
# TWITTER_API_KEY=your-api-key
# TWITTER_API_SECRET=your-api-secret

# =============================================================================
# Developer & Open Source APIs (optional)
# =============================================================================
# GitHub API (company tech presence, open source activity)
# Get token at: https://github.com/settings/tokens
# GITHUB_API_TOKEN=ghp_your-token-here

# Wikipedia API (no key required, but user agent recommended)
# WIKIPEDIA_USER_AGENT=CompanyResearcher/1.0 (your.email@example.com)

# =============================================================================
# API RATE LIMIT CONFIGURATION
# =============================================================================
# Override default rate limits for any provider. All values are optional.
# See src/core/api_limits.py for defaults and documentation.

# -----------------------------------------------------------------------------
# AI Provider Rate Limits
# -----------------------------------------------------------------------------
# OpenAI (Tier 2 defaults: 60 RPM, 90K TPM)
# Docs: https://platform.openai.com/docs/guides/rate-limits
# OPENAI_RPM=60                    # Requests per minute
# OPENAI_TPM=90000                 # Tokens per minute
# OPENAI_RPD=10000                 # Requests per day
# OPENAI_CONCURRENT=10             # Max concurrent requests
# OPENAI_COOLDOWN=60               # Cooldown after rate limit (seconds)
# OPENAI_MAX_RETRIES=3             # Max retry attempts

# Anthropic Claude (Tier 2 defaults: 60 RPM, 100K TPM)
# Docs: https://docs.claude.com/en/api/rate-limits
# ANTHROPIC_RPM=60
# ANTHROPIC_TPM=100000
# ANTHROPIC_RPD=10000
# ANTHROPIC_CONCURRENT=10
# ANTHROPIC_COOLDOWN=60
# ANTHROPIC_MAX_RETRIES=3

# Google Gemini (Paid Tier 1 defaults: 2000 RPM, 4M TPM)
# Docs: https://ai.google.dev/gemini-api/docs/rate-limits
# Free tier: 5-10 RPM, 250K TPM - adjust these if using free tier!
# GEMINI_RPM=2000
# GEMINI_TPM=4000000
# GEMINI_RPD=1000000
# GEMINI_CONCURRENT=50
# GEMINI_COOLDOWN=60
# GEMINI_MAX_RETRIES=3

# Groq (Free tier defaults: 30 RPM, 6K TPM)
# Docs: https://console.groq.com/docs/rate-limits
# GROQ_RPM=30
# GROQ_TPM=6000
# GROQ_RPD=1000
# GROQ_CONCURRENT=5
# GROQ_COOLDOWN=60
# GROQ_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Search Provider Rate Limits
# -----------------------------------------------------------------------------
# Global search manager settings (apply to all search providers)
# SEARCH_RATE_LIMIT_PER_MIN=30     # Global rate limit across all providers
# SEARCH_COOLDOWN_SECONDS=60       # Cooldown after hitting rate limit
# SEARCH_MAX_RETRIES=3             # Max retry attempts per provider
# SEARCH_BASE_BACKOFF=2.0          # Base backoff multiplier (seconds)
# SEARCH_TIMEOUT_SECONDS=30        # Request timeout (60 for DuckDuckGo)
# SEARCH_PARALLEL_TIMEOUT=30       # Parallel search timeout
# SEARCH_RESULTS_PER_PAGE=10       # Results per page
# SEARCH_MAX_PAGES=3               # Max pagination pages
# SEARCH_PAGE_DELAY=1.0            # Delay between pages (seconds)

# DuckDuckGo (FREE, unlimited, but can be slow)
# DUCKDUCKGO_RPM=30
# DUCKDUCKGO_RPD=5000
# DUCKDUCKGO_CONCURRENT=3

# Jina AI (FREE: 200 RPM with API key, 10M tokens)
# Docs: https://jina.ai/reader/
# JINA_RPM=200
# JINA_RPD=50000
# JINA_CONCURRENT=5

# Tavily (1,000 free/month, then $0.008/request)
# Docs: https://docs.tavily.com/documentation/rate-limits
# TAVILY_RPM=60
# TAVILY_RPD=1000
# TAVILY_CONCURRENT=5

# Serper.dev (2,500 free signup, up to 300 RPM paid)
# Docs: https://serper.dev/
# SERPER_RPM=300
# SERPER_RPD=50000
# SERPER_CONCURRENT=10

# Brave Search (2,000 free/month, 1 req/sec on free tier)
# Docs: https://brave.com/search/api/
# BRAVE_RPM=60
# BRAVE_RPD=2000
# BRAVE_CONCURRENT=1

# Bing Search (RETIRING Aug 2025, 1,000 free/month via Azure)
# Docs: https://azure.microsoft.com/en-us/pricing/details/cognitive-services/search-api/
# BING_RPM=60
# BING_RPD=1000
# BING_CONCURRENT=5

# LangSearch (FREE for individuals)
# LANGSEARCH_RPM=30
# LANGSEARCH_RPD=5000
# LANGSEARCH_CONCURRENT=5

# -----------------------------------------------------------------------------
# Financial Data Provider Rate Limits
# -----------------------------------------------------------------------------
# Alpha Vantage (25 requests/day free, 5 RPM)
# Docs: https://www.alphavantage.co/premium/
# ALPHA_VANTAGE_RPM=5
# ALPHA_VANTAGE_RPD=25
# ALPHA_VANTAGE_CONCURRENT=1
# ALPHA_VANTAGE_MAX_RETRIES=2

# FRED - Federal Reserve Economic Data (120 RPM free, unlimited daily)
# Docs: https://fred.stlouisfed.org/docs/api/fred/errors.html
# FRED_RPM=120
# FRED_RPD=100000
# FRED_CONCURRENT=10

# NewsAPI (100 requests/day free, 24-hour delay)
# Docs: https://newsapi.org/pricing
# NEWSAPI_RPM=10
# NEWSAPI_RPD=100
# NEWSAPI_CONCURRENT=2
