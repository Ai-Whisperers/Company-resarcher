# Company Researcher Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Authentication (required for production)
# =============================================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here

# =============================================================================
# AI Provider API Keys (at least one required)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# =============================================================================
# Search API Keys
# =============================================================================
TAVILY_API_KEY=tvly-your-tavily-key-here
NEWSAPI_KEY=your-newsapi-key-here
# SERPAPI_API_KEY=your-serpapi-key-here

# =============================================================================
# SEC EDGAR Identity (required for SEC filings)
# =============================================================================
SEC_IDENTITY=Your Name (your.email@example.com)

# =============================================================================
# Langfuse Observability (optional)
# =============================================================================
# LANGFUSE_PUBLIC_KEY=pk-your-public-key
# LANGFUSE_SECRET_KEY=sk-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# AI Configuration (optional - defaults shown)
# =============================================================================
# DEFAULT_MODEL=gpt-4o
# DEFAULT_TEMPERATURE=0.0
# DEFAULT_MAX_TOKENS=4000

# =============================================================================
# Application Configuration (optional)
# =============================================================================
# OUTPUT_DIR=outputs
# DB_PATH=tasks.db
# LOG_DIR=.
# PROMPTS_DIR=src/prompts
# TEMPLATES_DIR=src/templates

# =============================================================================
# API Server Configuration (optional)
# =============================================================================
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# MAX_REQUEST_SIZE_BYTES=1000000
# RESEARCH_TIMEOUT_SECONDS=1800

# =============================================================================
# Performance Tuning (optional)
# =============================================================================
# SEARCH_TIMEOUT_SECONDS=30
# VAULT_FILE_TIMEOUT_SECONDS=30
# ROUTER_COUNTER_RESET_SECONDS=3600
