# =============================================================================
# Company Researcher AI Configuration
# =============================================================================
# Primary/Fallback providers (uses nested delimiter __)
AI__PRIMARY=gemini
AI__FALLBACK=groq

# Gemini config (Google AI Ultra - high rate limits, best value)
AI__GEMINI__MODEL=gemini-2.0-flash
AI__GEMINI__TEMPERATURE=0.0
AI__GEMINI__MAX_TOKENS=8192

# Groq fallback config (fast, free tier)
AI__GROQ__MODEL=llama-3.3-70b-versatile
AI__GROQ__TEMPERATURE=0.0
AI__GROQ__MAX_TOKENS=4096

# OpenAI tertiary fallback
AI__OPENAI__MODEL=gpt-4o
AI__OPENAI__TEMPERATURE=0.0
AI__OPENAI__MAX_TOKENS=4096

# =============================================================================
# SEC EDGAR Identity (required for SEC filings research)
# =============================================================================
SEC_IDENTITY=Ivan Weissvanderpol (weissvanderpol.ivan@gmail.com)

# =============================================================================
# Company Researcher Output Configuration
# =============================================================================
OUTPUT_DIR=outputs
RESEARCH_TIMEOUT_SECONDS=1800
SEARCH_TIMEOUT_SECONDS=60

# =============================================================================
# Section Retry Configuration
# =============================================================================
# Enable retry for sections with insufficient search results (default: true)
SECTION_RETRY_ENABLED=true
# Maximum retry attempts per section (default: 2)
SECTION_MAX_RETRIES=2
# Delay before retry pass in seconds (allows rate limits to recover)
SECTION_RETRY_DELAY_SECONDS=30

